# MyIYKYK — Environment-Variablen (server-only)
# Kopieren: cp .env.example .env  → dann die 3 Werte einsetzen.
# .env selbst ist gitignored (Secrets gehören NICHT ins Repo).

# Supabase-Projekt-URL — Dashboard → Settings → API → Project URL
SUPABASE_URL=

# Supabase Service-Role-Key (voller DB-Zugriff!) — Dashboard → Settings → API →
# Project API keys → service_role (secret) → Reveal. Nur server-seitig nutzen.
SUPABASE_SERVICE_ROLE_KEY=

# Login-Passwort der App (frei wählbar; wird gegen das Eingabefeld geprüft)
ADMIN_PASSWORD=
